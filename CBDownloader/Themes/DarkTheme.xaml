<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Base Palette: Deep Obsidian and Vibrant Gold/Yellow -->
    <Color x:Key="WindowBackgroundColor">#101010</Color>
    <Color x:Key="WindowForegroundColor">#F8FAFC</Color>
    <Color x:Key="SecondaryForegroundColor">#94A3B8</Color>
    <Color x:Key="BorderColor">#27272A</Color>
    <Color x:Key="ProgressBarBackgroundColor">#1E1E24</Color>
    <Color x:Key="ThumbnailOverlayColor">#E60F0F10</Color>
    <Color x:Key="ItemBackgroundColor">#17171A</Color>
    
    <!-- Yellow / Gold Accent Colors -->
    <Color x:Key="AccentColor">#FACC15</Color>
    <Color x:Key="AccentHoverColor">#FDE047</Color>
    <Color x:Key="AccentDarkColor">#CA8A04</Color>
    
    <!-- Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="{StaticResource WindowForegroundColor}"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource SecondaryForegroundColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="{StaticResource ProgressBarBackgroundColor}"/>
    <SolidColorBrush x:Key="ThumbnailOverlayBrush" Color="{StaticResource ThumbnailOverlayColor}"/>
    <SolidColorBrush x:Key="ItemBackgroundBrush" Color="{StaticResource ItemBackgroundColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>

    <!-- Default Button: Sleek Dark with subtle border and yellow hover -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#1E1E22"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#2A2A30"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#333338"/>

    <!-- Primary Accent Button: Vibrant Yellow with crisp dark text -->
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#FACC15"/>
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#0A0A0B"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="#FDE047"/>

    <!-- Secondary Accent Button: Dark with Yellow border and Yellow text -->
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#18181B"/>
    <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="#FACC15"/>
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#FACC15"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="#2E2810"/>
</ResourceDictionary>
