<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Color x:Key="WindowBackgroundColor">#F8FAFC</Color>
    <Color x:Key="WindowForegroundColor">#0F172A</Color>
    <Color x:Key="SecondaryForegroundColor">#64748B</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="ProgressBarBackgroundColor">#E2E8F0</Color>
    <Color x:Key="ThumbnailOverlayColor">#E6FFFFFF</Color>
    <Color x:Key="ItemBackgroundColor">#FFFFFF</Color>
    
    <Color x:Key="AccentColor">#EAB308</Color>
    <Color x:Key="AccentHoverColor">#CA8A04</Color>
    <Color x:Key="AccentDarkColor">#A16207</Color>
    
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="{StaticResource WindowForegroundColor}"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource SecondaryForegroundColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ProgressBarBackgroundBrush" Color="{StaticResource ProgressBarBackgroundColor}"/>
    <SolidColorBrush x:Key="ThumbnailOverlayBrush" Color="{StaticResource ThumbnailOverlayColor}"/>
    <SolidColorBrush x:Key="ItemBackgroundBrush" Color="{StaticResource ItemBackgroundColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#CBD5E1"/>

    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#EAB308"/>
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="#CA8A04"/>

    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="#FACC15"/>
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="#1E293B"/>
</ResourceDictionary>
