<Window x:Class="CBDownloader.Views.DownloadToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CBDownloader Popup"
        Width="400" Height="130"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid MouseEnter="OnMouseEnterToast" MouseLeave="OnMouseLeaveToast">
        <!-- Main Card Border with Drop Shadow -->
        <Border Margin="8" Background="#141414" BorderBrush="#FACC15" BorderThickness="1.5" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.75"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="3"/>
                </Grid.RowDefinitions>

                <!-- Toast Content -->
                <Grid Grid.Row="0" Margin="10,8,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thumbnail / Clickable to open full app -->
                    <Border Grid.Column="0" Width="95" Height="68" CornerRadius="6" Background="#1F1F1F" 
                            BorderBrush="#2C2C2C" BorderThickness="1" Margin="0,0,10,0"
                            Cursor="Hand" MouseLeftButtonDown="OnOpenAppClick" ToolTip="Click to open full window">
                        <Grid ClipToBounds="True">
                            <TextBlock Text="🎬" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#555555"/>
                            <Image x:Name="ThumbnailImage" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <!-- Details & Action Buttons -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header Row: Tag & Close button -->
                        <Grid Grid.Row="0" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="11" Margin="0,0,3,0" Foreground="#FACC15"/>
                                <TextBlock Text="CBDownloader" FontSize="10" FontWeight="Bold" Foreground="#FACC15" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="CloseButton" Content="✕" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Foreground="#888888" FontSize="11" Padding="0" Cursor="Hand"
                                    Click="OnCloseClick">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Title (Clickable) -->
                        <TextBlock x:Name="TitleText" Grid.Row="1" Text="Fetching link..." FontSize="12" FontWeight="SemiBold"
                                   Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"
                                   Cursor="Hand" MouseLeftButtonDown="OnOpenAppClick" ToolTip="Click to open full window"/>

                        <!-- Action Buttons Row -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <!-- MP4 Button (Yellow) -->
                            <Button x:Name="Mp4Button" Content="⚡ MP4" Height="28" Width="96" Margin="0,0,8,0"
                                    Background="#FACC15" Foreground="#000000" FontWeight="Bold" FontSize="12"
                                    Cursor="Hand" Click="OnDownloadMp4Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="5,0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBorder" Property="Background" Value="#FDE047"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- MP3 Button (Dark with Yellow Border) -->
                            <Button x:Name="Mp3Button" Content="🎵 MP3" Height="28" Width="96"
                                    Background="#1C1C1C" Foreground="#FACC15" BorderBrush="#FACC15" BorderThickness="1"
                                    FontWeight="Bold" FontSize="12" Cursor="Hand" Click="OnDownloadMp3Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="5,0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBorder" Property="Background" Value="#2E2810"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 5-Second Countdown Indicator Bar -->
                <ProgressBar x:Name="CountdownBar" Grid.Row="1" Value="100" Maximum="100" Height="3" 
                             Background="#202020" Foreground="#FACC15" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
