<Window x:Class="CBDownloader.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - CBDownloader" Width="510" Height="500"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Icon="/Assets/icon.ico" Topmost="True"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="18">
        <StackPanel>
            <!-- Title Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <TextBlock Text="⚙️" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Settings" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource WindowForegroundBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Theme Picker -->
            <TextBlock Text="Interface Theme" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource WindowForegroundBrush}"/>
            <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding AppTheme}" Height="34" Margin="0,0,0,16"/>

            <!-- Downloads Location -->
            <TextBlock Text="Downloads Destination" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource WindowForegroundBrush}"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding DownloadFolderPath}" Height="34" VerticalContentAlignment="Center" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Browse" Height="34" Padding="12,0" Margin="6,0,0,0" Command="{Binding BrowseFolderCommand}"/>
            </Grid>

            <!-- Checkboxes -->
            <CheckBox IsChecked="{Binding StartWithWindows}" Content="Start CBDownloader with Windows" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
            <CheckBox IsChecked="{Binding AlwaysOnTop}" Content="Keep main window on top of other windows" Margin="0,0,0,16" VerticalContentAlignment="Center"/>

            <!-- Authentication / Cookies Card -->
            <Border BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource ItemBackgroundBrush}" 
                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Authentication (Optional)" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource WindowForegroundBrush}"/>
                    <CheckBox IsChecked="{Binding UseBrowserCookies}" Content="Enable Browser Cookies (for restricted content)" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                    
                    <StackPanel>
                        <TextBlock Text="Select Browser for Cookies:" Margin="0,0,0,4" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <ComboBox ItemsSource="{Binding AvailableBrowsers}" SelectedItem="{Binding BrowserForCookies}" IsEnabled="{Binding UseBrowserCookies}" Height="30"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Update Section -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentVersion}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"/>
                    <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Check for Updates" Style="{StaticResource PrimaryYellowButton}" 
                        Height="34" Padding="16,0" Command="{Binding CheckForUpdatesCommand}"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
