<Window x:Class="CBDownloader.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CBDownloader" Width="520" Height="640"
        MinWidth="420" MinHeight="450"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        Icon="/Assets/icon.ico"
        Background="{DynamicResource WindowBackgroundBrush}">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header: Logo Branding & Settings -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚡" FontSize="20" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="CB" FontSize="18" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="DOWNLOADER" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource WindowForegroundBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="⚙️ Settings" ToolTip="Open Settings" Height="30" Padding="12,0"
                    Command="{Binding OpenSettingsCommand}"/>
        </Grid>
        
        <!-- Media Preview & Quick Actions Card -->
        <Border Grid.Row="1" Background="{DynamicResource ItemBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                CornerRadius="10" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Video Title -->
                <TextBlock Grid.Row="0" Text="{Binding VideoTitle}" FontWeight="SemiBold" FontSize="13" 
                           TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource WindowForegroundBrush}" Margin="0,0,0,10"/>

                <!-- Thumbnail & Action Buttons -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thumbnail Container with Rounded Clip -->
                    <Border Grid.Column="0" Height="82" CornerRadius="8" Background="#111113" 
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                        <Grid ClipToBounds="True">
                            <TextBlock Text="🎬" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#444444"/>
                            <Image Source="{Binding VideoThumbnailUrl}" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <!-- Buttons Stack -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="⚡ Queue Video (MP4)" Height="36" Margin="0,0,0,8"
                                Style="{StaticResource PrimaryYellowButton}"
                                Command="{Binding DownloadVideoCommand}"/>
                        <Button Content="🎵 Queue Audio (MP3)" Height="36"
                                Style="{StaticResource SecondaryDarkYellowButton}"
                                Command="{Binding DownloadAudioCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Active Downloads Queue List -->
        <Border Grid.Row="2" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" CornerRadius="10" Margin="0,0,0,12" Padding="4">
            <ListView ItemsSource="{Binding Downloads}" BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ItemBackgroundBrush}" 
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" 
                                CornerRadius="8" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Thumbnail and Open Folder Overlay -->
                                <Border Grid.Column="0" Width="65" Height="44" CornerRadius="6" Background="#141416"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                    <Grid ClipToBounds="True">
                                        <TextBlock Text="🎬" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#444444"/>
                                        <Image Source="{Binding VideoThumbnailUrl}" Stretch="UniformToFill"/>
                                        <Button ToolTip="Open in Explorer" 
                                                Command="{Binding OpenFolderCommand}"
                                                Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource ThumbnailOverlayBrush}" 
                                                Foreground="{DynamicResource AccentBrush}" BorderThickness="0"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand">
                                            <TextBlock Text="📁" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                
                                <!-- Title, Progress & Status -->
                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding VideoTitle}" FontWeight="SemiBold" FontSize="12"
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource WindowForegroundBrush}"/>
                                    <ProgressBar Grid.Row="1" Value="{Binding DownloadProgress}" Maximum="100" Height="5" 
                                                 Margin="0,5,0,3"/>
                                    <TextBlock Grid.Row="2" Text="{Binding DownloadStatus}" FontSize="11" 
                                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                </Grid>
                                
                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Retry Video -->
                                    <Button Content="↻ Video" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="11"
                                            Command="{Binding RetryVideoCommand}" 
                                            Visibility="{Binding ShowRetry, Converter={StaticResource BoolToVis}}"/>
                                    <!-- Retry Audio -->
                                    <Button Content="↻ Audio" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="11"
                                            Command="{Binding RetryAudioCommand}" 
                                            Visibility="{Binding ShowRetry, Converter={StaticResource BoolToVis}}"/>
                                    <!-- Cancel Button -->
                                    <Button Content="✕" Width="26" Height="26" Padding="0" FontSize="11"
                                            Foreground="#EF4444" BorderBrush="#EF4444"
                                            Command="{Binding CancelCommand}" 
                                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Bottom Actions Footer -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Hide to Background" Height="36" Margin="0,0,8,0" 
                    Command="{Binding ExitCommand}"/>
            <Button Grid.Column="1" Content="🧹 Clear List" ToolTip="Clear Completed/Cancelled Downloads" 
                    Height="36" Padding="16,0" Command="{Binding ClearCompletedCommand}"/>
        </Grid>
    </Grid>
</Window>
