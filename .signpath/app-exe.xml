<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="CBDownloader.exe"
             product-name="CBDownloader"
             product-version="${version}"
             company-name="ClipBoardDownloader">
      <authenticode-sign />
    </pe-file>
    <pe-file path="CBDownloader.dll"
             product-name="CBDownloader"
             product-version="${version}"
             company-name="ClipBoardDownloader">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
